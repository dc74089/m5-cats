// Copy to include/secrets.h and fill in. include/secrets.h is gitignored.
//
// WiFi is used ONLY for a weekly NTP clock sync. Elapsed time does not depend
// on it (both the feeding and "now" are read from the same RTC), so if these
// are wrong the device still works -- only the "(7:42 am)" subtitle drifts.
#pragma once

#define WIFI_SSID     "your-network"
#define WIFI_PASSWORD "your-password"

// POSIX TZ string, so DST is handled on-device without re-flashing.
//   US Eastern : "EST5EDT,M3.2.0,M11.1.0"
//   US Pacific : "PST8PDT,M3.2.0,M11.1.0"
//   UK         : "GMT0BST,M3.5.0/1,M10.5.0"
//   Central EU : "CET-1CEST,M3.5.0,M10.5.0/3"
#define TIMEZONE "EST5EDT,M3.2.0,M11.1.0"
